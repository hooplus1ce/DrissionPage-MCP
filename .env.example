# DrissionPage MCP 全局配置
# 鼠标光标可视化开关 (true/1/yes 启用, false/0/no 关闭)
SHOW_CURSOR=true

# ---------------- 账号档案（D1 认证引导 / D4 多账号会话） ----------------
# 凭据只驻留服务端：工具按档案名取用，返回值永不含密码。
# 目标系统：APS 平台（demo18）——登录返回访问令牌，需写入 localStorage + cookie。
#
# 方式一（推荐，多档案）：HL_PROFILES_FILE 指向 TOML，格式见 README「账号档案与登录」
# HL_PROFILES_FILE=D:\path\to\profiles.toml
#
# 方式二（单档案，与环境变量契约一致）：下面的 HL_* 组成名为 HL_PROFILE 的档案（默认 default）
# HL_HOST_PREFIX=demo18   # 一键推导 host/URL：demo18 → demo18-scm.hoolinks.com
# HL_PROFILE=default      # 档案名
# HL_BASE_URL=            # 站点根 URL（覆盖推导值；带路径时该路径作为 API 前缀）
# HL_URL=                 # APS Admin URL（覆盖推导值，优先级高于 HL_HOST_PREFIX）
# HL_LOGIN_PAGE=          # 登录页 URL（作为 Referer）
# HL_USERNAME=            # 登录用户名
# HL_USERPWD=             # 登录密码
# HL_COOKIE_DOMAIN=       # cookie 域
# HL_ACCESS_DOMAIN=       # CDP 注入 cookie 的域
# HL_API_PREFIX=          # 登录接口路径前缀（默认空）
# HL_LOGIN_PATH=/scmpsm/login/signin          # 登录提交接口（JSON 体）
# HL_CAPTCHA_PATH=/scmpsm/login/validateCode  # 验证码接口
# HL_REFRESH_HTTP_TIMEOUT=20                  # 登录 HTTP 超时（秒）
#
# 登录契约覆盖（默认即 APS 契约，换系统时按需覆盖）
# HL_USERNAME_FIELD=userName          # 请求字段名
# HL_PASSWORD_FIELD=userPwd           # 请求字段名
# HL_SUCCESS_FIELD=ok                 # 成功判据字段
# HL_MESSAGE_FIELD=msg                # 提示语字段
# HL_TOKEN_FIELD=data                 # 令牌在响应 JSON 中的字段
# HL_TOKEN_STORE=HL-Access-Token      # 令牌写入的 localStorage 键名
#
# 登录态缓存（登录成功后自动写入，profile_open 优先复用）
# HL_SESSION_PERSIST=true             # false 则只在内存缓存
# HL_SESSION_DIR=.dpmcp/sessions      # 落盘目录（含令牌/会话 cookie，勿提交）
# HL_SESSION_TTL=43200                # 缓存有效期（秒，默认 12 小时）
# HL_CAPTCHA_TTL=180                  # 验证码挑战有效期（秒）

# 场景特性套件按需插拔（默认 x6 在普通页面隐藏，nav_menu 进流程设计时自动解锁）
# 可选值：x6, vtable 或组合 "x6,vtable"；设为空字符串 "" 则全部常驻暴露
# DISABLED_FEATURES=x6

# 工具搜索转换器（BM25 检索 + 10 大核心黄金工具常驻，可为大模型节省 ~75% Schema Tokens）
# 设为 true 时，初始工具仅暴露 12 个核心工具 + search_tools + call_tool，其余 40+ 工具按需搜索调用
# ENABLE_TOOL_SEARCH=false
